APP_NAME="Qiyan Nexus API"
ENVIRONMENT="dev"
# A2 minimum access control. Empty = open mode (dev default).
# Comma-separated allowlist matched against the X-Access-Token request header.
# Example: QIYAN_ACCESS_TOKENS="dev-token-1,internal-reviewer-2"
QIYAN_ACCESS_TOKENS=""

# Optional LLM provider selection. Default deterministic mode makes no external calls.
# Set QIYAN_LLM_PROVIDER="opencode_go" for the preferred local/provider smoke path.
# Use QIYAN_LLM_PROVIDER="anthropic" only for later optional Anthropic smoke.
QIYAN_LLM_PROVIDER="deterministic"
# ANTHROPIC_API_KEY is unprefixed on purpose — the anthropic SDK reads this name natively.
ANTHROPIC_API_KEY=""
QIYAN_OPENCODE_GO_API_KEY=""
QIYAN_OPENCODE_GO_BASE_URL="https://opencode.ai/zen/go/v1"
QIYAN_OPENCODE_GO_MODEL="deepseek-v4-flash"
QIYAN_OPENCODE_GO_MAX_TOKENS="1200"
QIYAN_OPENCODE_GO_TEMPERATURE="0.2"

# Semantic grounding gate: minimum claim↔cited-chunk cosine for external providers.
# Applies only to anthropic / opencode_go answers (deterministic/mock skip grounding).
# Default 0.40 leaves a safety buffer below the labeled fixture's faithful-claim floor
# (~0.50) so genuine paraphrases are never blocked. Set "0" (or any <=0) to disable.
# The default hashing embedding backend makes this a lexical-overlap proxy;
# QIYAN_EMBEDDING_BACKEND="bge" upgrades it to real semantics in place.
QIYAN_GROUNDING_SEMANTIC_THRESHOLD="0.40"
